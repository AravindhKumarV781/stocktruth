# Values for StockTruth. The setup script (scripts/azure_setup.sh) creates and fills ~/stocktruth.env for you.
# Format: KEY=value, one per line. No quotes, no spaces around "=". Lines starting with # are comments.

# ---- run mode (LLM_MODE: mock or azure | DATA_BACKEND: bundled or onelake)
LLM_MODE=mock
DATA_BACKEND=bundled

# ---- Azure OpenAI model deployed in Azure AI Foundry
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# MODEL_DEPLOYMENT is the deployment NAME you typed in Foundry
MODEL_DEPLOYMENT=gpt-4.1-mini
# set the two prices to your model's current prices (used for cost per case)
PRICE_PER_1M_INPUT_USD=0.40
PRICE_PER_1M_OUTPUT_USD=1.60

# ---- Fabric (needed for uploads and DATA_BACKEND=onelake)
FABRIC_WORKSPACE_ID=
FABRIC_LAKEHOUSE_ID=

# ---- optional services (pipeline falls back safely when blank)
SEARCH_ENDPOINT=
SEARCH_KEY=
SEARCH_INDEX=stocktruth-kb
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DB=stocktruth
COSMOS_CONTAINER=audit
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=
TEAMS_WEBHOOK_URL=

# ---- web app (the deploy script fills APP_URL and STATE_DIR)
APP_URL=
APP_PASSWORD=

# ---- Phase 2 CCTV (optional; defaults shown)
CCTV_WINDOW_MIN=30
CCTV_MIN_CONF=0.6
